    <script>
      // Split the animated text into individual letter spans
      const textEl = document.getElementById("hero-animation-text");
      const originalText = textEl.textContent;
      textEl.innerHTML = originalText
        .split("")
        .map((char) => {
          // keep spaces as spaces, wrap everything else in a span
          if (char === " ") return " ";
          return `<span class="letter">${char}</span>`;
        })
        .join("");

      // Run the animation automatically on page load
      window.addEventListener("DOMContentLoaded", () => {
        anime.timeline({ loop: false })
          .add({
            targets: '#hero-animation-text .letter',
            translateY: [40, 0],
            opacity: [0, 1],
            easing: "easeOutExpo",
            duration: 900,
            delay: anime.stagger(35)
          });
      });
    </script>

    <!-- Three.js cube-burst animation (replaces the About Us sandbox image) -->
    <!-- NOTE: type="module" requires this page to be served over http/https -->
    <!-- (e.g. via your Express server, or Railway once deployed) -->
    <!-- Opening the file directly (file://) will NOT run this section. -->
    <script type="module">
      import * as THREE from "https://esm.sh/three@0.166.0";
      import { animate, stagger } from "https://esm.sh/animejs@4.5.0";
      import { getInstances } from "https://esm.sh/animejs@4.5.0/adapters/three";

      const container = document.getElementById("about-animation-container");

      if (container) {
        const width = container.clientWidth;
        const height = container.clientHeight;

        // Basic Three.js scene setup
        const scene = new THREE.Scene();
        const camera = new THREE.PerspectiveCamera(50, width / height, 0.1, 1000);
        camera.position.z = 30;

        const renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });
        renderer.setSize(width, height);
        container.appendChild(renderer.domElement);

        // Lighting so the cubes are visible
        const ambient = new THREE.AmbientLight(0xffffff, 0.6);
        scene.add(ambient);
        const light = new THREE.DirectionalLight(0xffffff, 1);
        light.position.set(5, 5, 5);
        scene.add(light);

        // One geometry + material shared by all cube instances
        const geometry = new THREE.BoxGeometry(1, 1, 1);
        const material = new THREE.MeshStandardMaterial({ color: 0x21a1f1 });

        const count = 120;
        const instancedMesh = new THREE.InstancedMesh(geometry, material, count);
        scene.add(instancedMesh);

        // Scatter cubes randomly around the scene (their starting position)
        const dummy = new THREE.Object3D();
        for (let i = 0; i < count; i++) {
          dummy.position.set(
            (Math.random() - 0.5) * 45,
            (Math.random() - 0.5) * 45,
            (Math.random() - 0.5) * 45
          );
          dummy.scale.setScalar(0.3);
          dummy.updateMatrix();
          instancedMesh.setMatrixAt(i, dummy.matrix);
        }
        instancedMesh.instanceMatrix.needsUpdate = true;

        // Keep rendering every frame so the animation is visible
        function renderLoop() {
          requestAnimationFrame(renderLoop);
          instancedMesh.instanceMatrix.needsUpdate = true;
          renderer.render(scene, camera);
        }
        renderLoop();

        // Animate every cube instance flying in toward the center, on page load
        const instances = getInstances(instancedMesh);
        animate(instances, {
          x: 0,
          y: 0,
          z: 0,
          scale: 1,
          delay: stagger(15),
          duration: 1400,
          easing: "easeOutExpo"
        });
      }
    </script>
