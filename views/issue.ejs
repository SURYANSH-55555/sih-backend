<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>EduVerse | Issue & Verify</title>

  <!-- Links to your specific Issue CSS file -->
  <link rel="stylesheet" href="/css/pages/issue.css">
</head>

<body>

  <!-- Top Dark Header Navigation -->
  <header>
    <div class="brand-section">
      <div class="brand-icon">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"
          stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
        </svg>
      </div>
      <div class="brand-text">
        <h2>EduVerse</h2>
        <span>Credential Console</span>
      </div>
    </div>

    <!-- Top Navigation Links -->
    <ul class="nav-links">
      <li>
        <a href="/dashboard">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="3" y="3" width="7" height="7" />
            <rect x="14" y="3" width="7" height="7" />
            <rect x="14" y="14" width="7" height="7" />
            <rect x="3" y="14" width="7" height="7" />
          </svg>
          Overview
        </a>
      </li>
      <li>
        <a href="/dashboard/issue" class="active">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
            <polyline points="14 2 14 8 20 8" />
          </svg>
          Issue & Verify
        </a>
      </li>
      <li>
        <a href="/dashboard/revoke">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8" />
            <path d="M3 3v5h5" />
          </svg>
          Revocation Registry
        </a>
      </li>
    </ul>

    <div class="header-right">
      <a href="/logout" style="text-decoration: none;">
        <button class="btn-logout">Logout</button>
      </a>
    </div>
  </header>

  <!-- Centered Content Canvas -->
  <main class="dashboard-content">

    <div class="page-header">
      <h1>Issue & Verify</h1>
      <p>Generate cryptographically signed credentials for students.</p>
    </div>

    <!-- 2-Column Grid Wrapper -->
    <div class="issue-grid">

      <!-- LEFT COLUMN: Form Card -->
      <div class="card">
        <span class="card-badge">ACADEMIC CREDENTIAL SYSTEM</span>
        <h2 class="card-title">Issue a Certificate</h2>

        <form action="/generate-hash" method="POST">
          <div class="input-group">
            <label>Student Name</label>
            <input type="text" name="studentName" placeholder="Enter student name..." required 
                   value="<%= locals.credentialData ? credentialData.studentName : '' %>">
          </div>

          <div class="form-row">
            <div class="input-group">
              <label>Roll Number</label>
              <input type="text" name="rollNo" placeholder="Enter roll number..." required
                     value="<%= locals.credentialData ? credentialData.rollNo : '' %>">
            </div>
            <div class="input-group">
              <label>Degree</label>
              <% 
                const degrees = ["B.E.", "B.Tech", "B.Tech + M.Tech", "MBA", "M.Tech"];
              %>
              <select name="degree" required>
                <option value="" disabled <%= !locals.credentialData ? 'selected' : '' %>>Select degree...</option>
                <% degrees.forEach(function(deg) { %>
                  <option value="<%= deg %>" <%= locals.credentialData && credentialData.degree === deg ? 'selected' : '' %>><%= deg %></option>
                <% }); %>
              </select>
            </div>
          </div>

          <div class="form-row">
            <div class="input-group">
              <label>Graduation Year</label>
              <input type="number" name="gradYear" placeholder="Enter graduation year..." required
                     value="<%= locals.credentialData ? credentialData.gradYear : '' %>">
            </div>
            <div class="input-group">
              <label>Branch</label>
              <% 
                const branches = [
                  "Biomedical Engineering (B.Tech. - 4yrs)", "Biotechnology (B.Tech. - 4yrs)", "Civil Engineering (B.Tech. - 4yrs)",
                  "Chemical Engineering (B.Tech. - 4yrs)", "Chemical Engineering (B.Tech. M.Tech Dual Degree - 5yrs)",
                  "Ceramic Engineering (B.Tech. - 4yrs)", "Industrial Ceramic (B.Tech. M.Tech Dual Degree - 5yrs)",
                  "Artificial Intelligence (B.Tech. - 4yrs)", "Computer Science and Engineering (B.Tech. - 4yrs)",
                  "Chemistry (Integrated M.Sc. - 5yrs)", "Electronics and Communication Engineering (B.Tech. - 4yrs)",
                  "Electronics and Instrumentation Engineering (B.Tech. - 4yrs)", "Electrical Engineering (B.Tech. - 4yrs)",
                  "Food Process Engineering (B.Tech. - 4yrs)", "Industrial Design (B.Tech. - 4yrs)",
                  "Life Science (Integrated M.Sc. - 5yrs)", "Mathematics and Computing (B.Tech. - 4yrs)",
                  "Mathematics (Integrated M.Sc. - 5yrs)", "Mechanical Engineering (B.Tech. - 4yrs)",
                  "Metallurgical and Materials Engineering (B.Tech. - 4yrs)",
                  "Metallurgical and Materials Engineering (B.Tech. M.Tech Dual Degree - 5yrs)",
                  "Mining Engineering (B.Tech. - 4yrs)", "Mining Engineering (B.Tech. M.Tech Dual Degree - 5yrs)",
                  "Architecture (B.Arch. - 5yrs)", "Engineering Physics (B.Tech. - 4yrs)", "Physics (Integrated M.Sc. - 5yrs)"
                ];
              %>
              <select name="branch" required>
                <option value="" disabled <%= !locals.credentialData ? 'selected' : '' %>>Select branch...</option>
                <% branches.forEach(function(b) { %>
                  <option value="<%= b %>" <%= locals.credentialData && credentialData.branch === b ? 'selected' : '' %>><%= b %></option>
                <% }); %>
              </select>
            </div>
          </div>

          <button type="submit" class="btn-issue-submit">Issue Certificate</button>
        </form>
      </div>

      <!-- RIGHT COLUMN: Generated Credential Display Card -->
      <div class="card">
        <span class="card-badge">OUTPUT PREVIEW</span>
        <h3 class="card-title">Generated Credential</h3>
        <p class="card-desc">Every issued record is hashed with SHA-256 and signed with the institution's private key.</p>

        <% if (!locals.credentialData) { %>
          <!-- EMPTY STATE -->
          <div class="empty-state-box">
            <div class="qr-icon">🔲</div>
            <p>Fill in the form and issue a certificate to generate its hash, signature, and QR code.</p>
          </div>
        <% } else { %>
          <!-- SUCCESS STATE -->
          <div class="success-state-box">
            <div class="success-badge">✅ Credential Secured</div>

            <div class="data-row"><strong>Name:</strong>
              <%= credentialData.studentName %>
            </div>
            <div class="data-row"><strong>Cert ID:</strong>
              <%= credentialData.id %>
            </div>

            <div class="hash-display">
              <div class="hash-label">SHA-256 Fingerprint:</div>
              <div class="hash-string">
                <%= credentialData.hash %>
              </div>
            </div>

            <% if (credentialData && credentialData.qrCode) { %>
              <!-- Dynamic QR Code generated by Node.js -->
              <div class="text-center mt-4">
                <img src="<%= credentialData.qrCode %>" alt="Verification QR Code"
                  style="width: 160px; height: 160px; border-radius: 8px; border: 1px solid #e2e8f0; padding: 5px;">
                <p class="text-muted mt-2" style="font-size: 0.85rem; font-weight: 600;">Scan to Verify</p>
              </div>
            <% } else { %>
              <!-- Placeholder before a certificate is issued -->
              <div class="text-center mt-4 p-5 bg-light rounded" style="border: 2px dashed #cbd5e1;">
                <p class="text-muted mb-0">Fill out the form to generate the credential and QR code.</p>
              </div>
            <% } %>
          </div> 
        <% } %> 
            
      </div> 
  </main>

</body>

</html>